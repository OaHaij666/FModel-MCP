<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <!-- The MCP server reports this through initialize, so agents can tell which build they are
         talking to. The Release workflow overrides it from the git tag; this default is deliberately
         not a release number so a local build can never masquerade as a published one. -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <AssemblyVersion Condition="'$(Version)' == ''">0.0.0.0</AssemblyVersion>
    <FileVersion Condition="'$(Version)' == ''">0.0.0.0</FileVersion>
    <Product>FModel MCP</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FModel/FModel.csproj" />
  </ItemGroup>
</Project>
