<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <!-- The MCP server reports this through initialize, so agents can tell which build they are
         talking to. Keep it aligned with the GitHub release tag. -->
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Product>FModel MCP</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FModel/FModel.csproj" />
  </ItemGroup>
</Project>
